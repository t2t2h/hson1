<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Agora Call Recorder</string>
			<key>footerText</key>
			<string>Records this app's own calls locally on this device. Nothing is sent anywhere unless you enable auto-upload or tap Upload manually on a saved recording.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enable Recording</string>
			<key>key</key>
			<string>RecordingEnabled</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yourname.agorarecorder</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Auto-Upload After Call</string>
			<key>key</key>
			<string>AutoUploadEnabled</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yourname.agorarecorder</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Live Listening</string>
			<key>footerText</key>
			<string>Plays the call back through this device's speaker/headphones while it's being recorded. Purely local audio routing — nothing is sent anywhere.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
