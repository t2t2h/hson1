			<string>LiveMonitor3xEnabled</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.yourname.agorarecorder</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldCell</string>
